# Copy this file to .env and fill in your Gemini key. The other settings are optional.

# Your Gemini API key, from https://aistudio.google.com/apikey
# It is used for speech-to-text, the app's voice, and g.ai.
GEMINI_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# The port the server listens on.
# PORT=3000

# The voice. gemini: a natural voice, about 2 to 5 seconds to make each sentence.
# device: the phone's or browser's built-in voice, instant and free.
# VOICE=gemini
# TTS_VOICE=Kore

# Models. If your key cannot use one, the app switches to the fallback on its own.
# GEMINI_MODEL=gemini-3.5-flash
# FALLBACK_MODEL=gemini-flash-latest
# TTS_MODEL=gemini-3.1-flash-tts-preview

# The address the phone uses to reach this laptop. Leave it empty and the
# starter finds one (the tunnel while `bun run tunnel` runs, else this
# laptop's Wi-Fi address). Set it when you use another tunnel, such as ngrok.
# PUBLIC_URL=

# How photos travel from the glasses. auto: over the glasses' Wi-Fi when it
# can, else through the phone over Bluetooth. ble: through the phone.
# PHOTO_TRANSFER=auto

# Spending safety. Past either limit, Gemini is switched off until restart.
# GEMINI_MAX_CALLS_PER_MINUTE=60
# GEMINI_MAX_CALLS_PER_RUN=800
# Stop on its own after this many minutes without speech or a button press.
# IDLE_STOP_MIN=20

# The dashboard shows camera photos, so other devices cannot open it.
# DASHBOARD_FROM_ANYWHERE=false
